# Copy to .env.local for local development.
#
# Where the Express backend is listening. next.config.ts rewrites /api/v1/* and
# /socket.io/* to this origin so the browser sees a single origin — that keeps
# the httpOnly auth cookie working and avoids needing CORS on the backend.
#
# Defaults to http://localhost:3000 if unset.
BACKEND_ORIGIN=http://localhost:3000

# Note: the frontend dev server runs on port 3001 (see "dev" in package.json),
# because the backend already occupies 3000.
